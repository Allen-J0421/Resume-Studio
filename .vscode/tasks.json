{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Résumé-Studio: Start server",
      "type": "shell",
      "command": "npm start",
      "osx": {
        "command": "bash \"${workspaceFolder}/scripts/start-server.sh\""
      },
      "linux": {
        "command": "bash \"${workspaceFolder}/scripts/start-server.sh\""
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "resume-studio",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting ",
          "endsPattern": "ready at http"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      }
    },
    {
      "label": "Résumé-Studio: Show in VS Code",
      "type": "shell",
      "command": "echo ${input:openResumePreview}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false
      }
    },
    {
      "label": "Résumé-Studio: Open editor",
      "dependsOrder": "sequence",
      "dependsOn": ["Résumé-Studio: Start server", "Résumé-Studio: Show in VS Code"],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "openResumePreview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:4319"
    }
  ]
}
